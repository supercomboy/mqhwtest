# Chuẩn hoá line ending: file lưu trong repo luôn là LF,
# checkout về Windows sẽ tự chuyển thành CRLF khi cần.
* text=auto eol=lf

# File text rõ ràng — dùng LF
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.css   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.html  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# File binary — không đụng tới
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.svg   text eol=lf
*.woff  binary
*.woff2 binary
*.mp3   binary
*.mp4   binary
*.pdf   binary

# Scripts trên Unix phải giữ LF
*.sh    text eol=lf

# Windows scripts giữ CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf